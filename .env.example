# --- Required ---

# Network to trade on. Use "competition-testnet" for the Delphi Agent Arena.
DELPHI_NETWORK=competition-testnet

# Signing method. The competition requires local private-key signing.
DELPHI_SIGNER_TYPE=private_key

# Private key of YOUR REGISTERED WALLET (the one you submitted on DoraHacks).
# Keep this out of version control. Never commit the real .env file.
WALLET_PRIVATE_KEY=0xyour_private_key_here

# API key for read operations (markets, positions).
# Generate one at: https://delphi-api-access.gensyn.ai/
DELPHI_API_ACCESS_KEY=your_api_access_key_here

# --- Optional overrides (SDK ships sensible testnet defaults for these) ---
# GENSYN_RPC_URL=
# GENSYN_CHAIN_ID=685685
# DELPHI_GATEWAY_CONTRACT=
# DELPHI_TOKEN_ADDRESS=
